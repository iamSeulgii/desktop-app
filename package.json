{
  "name": "desktop-app",
  "version": "1.0.0",
  "description": "A cute always-on-top desktop companion app.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable",
    "build:win": "electron-builder --win portable",
    "build:mac": "electron-builder --mac",
    "build:mac:arm64": "electron-builder --mac --arm64",
    "build:mac:x64": "electron-builder --mac --x64"
  },
  "devDependencies": {
    "electron": "^21.2.1",
    "electron-builder": "^24.13.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-builder"
    ]
  },
  "build": {
    "appId": "com.desktop.app",
    "productName": "Desktop App",
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      },
      {
        "from": "config.json",
        "to": "config.json"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": "portable"
    },
    "mac": {
      "icon": "build/icon-mac.png",
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        },
        {
          "target": "zip",
          "arch": ["arm64", "x64"]
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null
    },
    "dmg": {
      "writeUpdateInfo": false
    }
  }
}
